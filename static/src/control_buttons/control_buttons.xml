<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_calculator.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[i[hasclass('fa-upload')]]" position="before">
            <button t-if="!props.showRemainingButtons and !this.pos.isSmallProductScreen" 
                    t-attf-class="{{ buttonClass }}" 
                    t-on-click="onClickCalculator"
                    title="Calculator">
                <i class="fa fa-calculator" role="img" aria-label="Calculator"/>
            </button>
        </xpath>
    </t>
</templates>
