<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_calculator.CalculatorDialog">
        <Dialog title="'Calculator'">
            <div class="calculator-container p-3 text-center">
                <div class="calculator-screen mb-3 p-2 bg-light border rounded text-end" style="font-size: 24px; min-height: 50px;">
                    <div class="text-muted small" style="min-height: 20px;"><t t-esc="state.equation"/></div>
                    <div class="fw-bold"><t t-esc="state.input"/></div>
                </div>
                <div class="calculator-keypad d-grid gap-2" style="grid-template-columns: repeat(5, 1fr);">
                    <button class="btn btn-secondary py-3 fs-5" t-on-click="() => this.clearAll()">C</button>
                    <button class="btn btn-secondary py-3 fs-5" t-on-click="() => this.clearEntry()">CE</button>
                    <button class="btn btn-secondary py-3 fs-5" t-on-click="() => this.backspace()">⌫</button>
                    <button class="btn btn-secondary py-3 fs-5" t-on-click="() => this.appendValue('%')">%</button>
                    <button class="btn btn-warning py-3 fs-5" t-on-click="() => this.appendValue('÷')">÷</button>
                    
                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('7')">7</button>
                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('8')">8</button>
                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('9')">9</button>
                    <button class="btn btn-info py-3 fs-5" t-on-click="() => this.applyScientific('sqrt')">√x</button>
                    <button class="btn btn-warning py-3 fs-5" t-on-click="() => this.appendValue('×')">×</button>

                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('4')">4</button>
                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('5')">5</button>
                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('6')">6</button>
                    <button class="btn btn-info py-3 fs-5" t-on-click="() => this.applyScientific('sqr')">x²</button>
                    <button class="btn btn-warning py-3 fs-5" t-on-click="() => this.appendValue('-')">-</button>

                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('1')">1</button>
                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('2')">2</button>
                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('3')">3</button>
                    <button class="btn btn-info py-3 fs-5" t-on-click="() => this.applyScientific('pow')">x^y</button>
                    <button class="btn btn-warning py-3 fs-5" t-on-click="() => this.appendValue('+')">+</button>

                    <button class="btn btn-light border py-3 fs-5" style="grid-column: span 2;" t-on-click="() => this.appendValue('0')">0</button>
                    <button class="btn btn-light border py-3 fs-5" t-on-click="() => this.appendValue('.')">.</button>
                    <button class="btn btn-primary py-3 fs-5" style="grid-column: span 2;" t-on-click="() => this.calculate()">=</button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>